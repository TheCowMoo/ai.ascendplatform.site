# Copy this file to .env and fill in your real values. NEVER commit .env to git.

# --- Product -----------------------------------------------------------
BRAND_NAME=CMGrowthAI
# Public hostname that Caddy serves and issues a TLS certificate for.
# Point this domain's A record at the server before starting the stack.
ADMIN_DOMAIN=ai.example.com

# --- Database ----------------------------------------------------------
# Local development (default): sqlite:///data/app.db
# docker compose overrides this with the Postgres URL automatically.
DATABASE_URL=sqlite:///data/app.db

# Postgres credentials used by docker compose (change POSTGRES_PASSWORD!)
POSTGRES_DB=cmgrowthai
POSTGRES_USER=cmgrowthai
POSTGRES_PASSWORD=change-me

# Reserved for the stage S3 agent worker (arq)
REDIS_URL=redis://localhost:6379/0

# How agent jobs are executed:
#   local  - in-process thread (default; good for development)
#   redis  - enqueue onto the arq worker (docker compose sets this)
JOB_BACKEND=local
JOB_TIMEOUT=900
WORKER_MAX_JOBS=4

# --- Agents ------------------------------------------------------------
# Model that routes the team when team_mode = selector
AGENT_ROUTER_PROVIDER=deepseek
AGENT_ROUTER_MODEL=
# Hard stop for a team run (protects against runaway loops)
AGENT_MAX_MESSAGES=20
# Cap on a single SSE stream, in seconds
SSE_MAX_SECONDS=600

# --- LLM providers -----------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- The spoken assistant (Gemini Live) ---------------------------------
# The browser opens the Live socket with a one-use token this server mints,
# so the key stays here. Leave the model blank for the build's current
# default (gemini-3.8-live); Settings -> Voice -> Test lists what the key
# can actually see. Ephemeral tokens are v1alpha in the installed SDK.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_API_VERSION=v1alpha
GEMINI_VOICE=Kore
VOICE_DAILY_MINUTES=10

# --- Media tab -----------------------------------------------------------
# Uploaded images, video and PDFs live here. The default is inside the
# artifacts bind mount, which the app already owns. Every upload needs alt
# text and a description before it can be saved.
MEDIA_DIR=artifacts/media
MEDIA_MAX_BYTES=50000000

# --- LiteLLM gateway (optional) ----------------------------------------
# When set, ALL providers are reached through this one OpenAI-compatible
# endpoint instead of directly. Start it with:
#   docker compose --profile gateway up -d litellm
# Provider keys then live on the gateway and you get spend tracking, retries
# and fallbacks. Leave blank to call the providers directly (the default).
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=sk-cmgrowthai

# --- App ---------------------------------------------------------------
# Internal bind address/port (Caddy forwards here)
HOST=127.0.0.1
PORT=5000

# Safety cap on how much of the KB is injected into the prompt
MAX_KB_CHARS=30000

# Admin account (seeded on first run only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Admin

# Session secret (leave blank to auto-generate a persistent key)
SECRET_KEY=

# --- Hosting (Sites / Servers) -----------------------------------------
# Public IP of the machine that serves the sites. The Sites tab tells the user
# to point their A record here; Caddy issues the TLS certificate automatically.
SERVER_IP=
# Where site content and per-site web-server config live (container paths).
SITE_ROOT=/srv/sites
CADDY_SITES_DIR=/etc/caddy/sites
CADDYFILE=/etc/caddy/Caddyfile
CADDY_RELOAD_CMD=caddy reload --config /etc/caddy/Caddyfile

# --- Actions (safety) --------------------------------------------------
# Blank = DRY-RUN: every write/exec action is simulated and never executed.
# Set to 1 only when you are ready for the agent to act on real servers.
ALLOW_LIVE_ACTIONS=
# How long a live action waits for your approval before giving up (seconds).
APPROVAL_TIMEOUT=300

# --- SSH ---------------------------------------------------------------
SSH_TIMEOUT=15
SSH_CMD_TIMEOUT=60
SSH_MAX_OUTPUT=40000

# --- Email -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1

# --- Artifacts (generated images, files) -------------------------------
ARTIFACTS_DIR=artifacts

# --- Pexels (stock photography) ----------------------------------------
# Free key: https://www.pexels.com/api/  With it, agents can pull real photos
# into the content they build (hero images, blog art, social cards) instead of
# only generating images.
# NOTE: every key in this file can also be set in the admin Settings tab, which
# takes precedence over this file and applies without a restart.
PEXELS_API_KEY=
# Results per search (1-80)
PEXELS_PER_PAGE=5
PEXELS_TIMEOUT=20
# Size cap for a downloaded photo, in bytes
PEXELS_MAX_BYTES=8000000

# --- Meta channels (Messenger / Instagram / WhatsApp) ------------------
GRAPH_API_VERSION=v21.0

# Optional globals. Leave blank to configure these per channel in the admin
# panel (recommended when each client uses a different Meta app).
# META_APP_SECRET is required to verify incoming webhook signatures.
META_APP_SECRET=
META_VERIFY_TOKEN=
