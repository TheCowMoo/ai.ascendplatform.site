# Copy this file to .env and fill in your real values. NEVER commit .env to git.

# --- Product -----------------------------------------------------------
BRAND_NAME=AscendPlatform
# Public hostname that Caddy serves and issues a TLS certificate for.
# Point this domain's A record at the server before starting the stack.
ADMIN_DOMAIN=ai.example.com
# Contact address sent to the certificate authority. Let's Encrypt refuses example.com
# contacts, so use a mailbox you read; it only receives expiry notices.
ACME_EMAIL=

# --- Database ----------------------------------------------------------
# Local development (default): sqlite:///data/app.db
# docker compose overrides this with the Postgres URL automatically.
DATABASE_URL=sqlite:///data/app.db

# Postgres credentials used by docker compose (change POSTGRES_PASSWORD!)
POSTGRES_DB=cmgrowthai
POSTGRES_USER=cmgrowthai
POSTGRES_PASSWORD=change-me

# Reserved for the stage S3 agent worker (arq)
REDIS_URL=redis://localhost:6379/0

# How agent jobs are executed:
#   local  - in-process thread (default; good for development)
#   redis  - enqueue onto the arq worker (docker compose sets this)
JOB_BACKEND=local
JOB_TIMEOUT=900
WORKER_MAX_JOBS=4

# --- Agents ------------------------------------------------------------
# Model that routes the team when team_mode = selector
AGENT_ROUTER_PROVIDER=deepseek
AGENT_ROUTER_MODEL=
# Hard stop for a team run (protects against runaway loops)
AGENT_MAX_MESSAGES=20
# Cap on a single SSE stream, in seconds
SSE_MAX_SECONDS=600

# --- LLM providers -----------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- The spoken assistant (Gemini Live) ---------------------------------
# The browser opens the Live socket with a one-use token this server mints,
# so the key stays here. Leave the model blank for the build's current
# default (gemini-3.8-live); Settings -> Voice -> Test lists what the key
# can actually see. Ephemeral tokens are v1alpha in the installed SDK.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_API_VERSION=v1alpha
GEMINI_VOICE=Kore
VOICE_DAILY_MINUTES=10

# --- Media tab -----------------------------------------------------------
# Uploaded images, video and PDFs live here. The default is inside the
# artifacts bind mount, which the app already owns. Every upload needs alt
# text and a description before it can be saved.
MEDIA_DIR=artifacts/media
MEDIA_MAX_BYTES=50000000

# --- LiteLLM gateway (optional) ----------------------------------------
# When set, ALL providers are reached through this one OpenAI-compatible
# endpoint instead of directly. Start it with:
#   docker compose --profile gateway up -d litellm
# Provider keys then live on the gateway and you get spend tracking, retries
# and fallbacks. Leave blank to call the providers directly (the default).
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=sk-your-gateway-key-here

# --- App ---------------------------------------------------------------
# Public origin used for links, the OAuth redirect fallback, and the chat widget
# injected into a client's site. Without it, attaching a chat assistant is refused.
PLATFORM_URL=
# Publish /api/docs and /api/openapi.json. Off by default: the schema describes every
# route and parameter and needs no session. Set 1 only for development or an operator.
API_DOCS=0
# Largest request body the app accepts (media uploads need room). Public JSON
# routes are separately capped at 256 KB.
MAX_REQUEST_BYTES=67108864
# Internal bind address/port (Caddy forwards here)
HOST=127.0.0.1
PORT=5000

# Safety cap on how much of the KB is injected into the prompt
MAX_KB_CHARS=30000

# Admin account (seeded on first run only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Admin

# Session secret (leave blank to auto-generate a persistent key)
SECRET_KEY=
# Dedicated key for encrypting Google OAuth refresh/access tokens. Leave blank to
# derive one from SECRET_KEY; changing either key requires reconnecting Google.
OAUTH_TOKEN_KEY=
# Cookies are Secure by default in the Compose production stack. Set to 0 only for a
# plain-HTTP local checkout; the browser cannot send a Secure cookie over http.
SESSION_COOKIE_SECURE=1
SESSION_HOURS=12

# --- Hosting (Sites / Servers) -----------------------------------------
# Public IP of the machine that serves the sites. The Sites tab tells the user
# to point their A record here; Caddy issues the TLS certificate automatically.
SERVER_IP=
# Where site content and per-site web-server config live (container paths).
SITE_ROOT=/srv/sites
CADDY_SITES_DIR=/etc/caddy/sites
CADDYFILE=/etc/caddy/Caddyfile
# How a live run asks Caddy to re-read its config. The compose stack sets this to Caddy's
# admin API, because that Python image has no caddy binary; leave it blank for a host
# install where the caddy CLI is on PATH.
CADDY_ADMIN_URL=
# Used only for a remote target (an ssh_hosts server with caddy installed).
# CADDY_RELOAD_CMD=caddy reload --config /etc/caddy/Caddyfile

# --- Background work ---------------------------------------------------
# How often the coordinator runs: DNS re-checks, due automations, delayed wakes,
# analytics alerts, weekly reviews and the monthly credit grant. 0 disables only
# the DNS re-check; the rest still run.
SITE_VERIFY_MINUTES=60
# Weekday for weekly site reviews, 0 = Monday. 7 (or unset) turns them off.
SITE_REVIEW_WEEKDAY=7
# Analytics/site-log sync interval in hours. 0 (the default) turns only this sync off.
SITE_LOG_SYNC_HOURS=0
# 0 turns every background sweep off (maintenance windows and tests).
SCHEDULER_ENABLED=1

# --- Actions (safety) --------------------------------------------------
# Blank = DRY-RUN: every write/exec action is simulated and never executed.
# Set to 1 only when you are ready for the agent to act on real servers.
ALLOW_LIVE_ACTIONS=
# How long a live action waits for your approval before giving up (seconds).
APPROVAL_TIMEOUT=300

# --- SSH ---------------------------------------------------------------
SSH_TIMEOUT=15
SSH_CMD_TIMEOUT=60
SSH_MAX_OUTPUT=40000

# --- Analytics ----------------------------------------------------------
# Google OAuth is the client-facing path. Create a Web application OAuth client in
# Google Cloud, enable the Analytics Data API, Analytics Admin API, Tag Manager API and
# BigQuery API, and register both callbacks:
#   https://<ADMIN_DOMAIN>/api/analytics/oauth/google/callback
#   https://<ADMIN_DOMAIN>/api/analytics/google/account-ticket/callback
# Read access is requested first; "Grant Google setup access" asks for analytics.edit,
# the tagmanager edit/publish scopes and bigquery.readonly. Both redirect URIs can be
# left blank to derive them from PLATFORM_URL/ADMIN_DOMAIN.
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REDIRECT_URI=
GA4_ACCOUNT_TICKET_REDIRECT_URI=
# Fallback for existing/service-account-managed GA4 sources only.
GA4_SERVICE_ACCOUNT_KEY_PATH=
GA4_SERVICE_ACCOUNT_EMAIL=

# --- Client notifications ----------------------------------------------
# Lead and automation notices to the client's own admins. Turn off for a test install.
NOTIFICATIONS_ENABLED=1

# --- Email -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1

# --- Artifacts (generated images, files) -------------------------------
ARTIFACTS_DIR=artifacts

# --- Pexels (stock photography) ----------------------------------------
# Free key: https://www.pexels.com/api/  With it, agents can pull real photos
# into the content they build (hero images, blog art, social cards) instead of
# only generating images.
# NOTE: every key in this file can also be set in the admin Settings tab, which
# takes precedence over this file and applies without a restart.
PEXELS_API_KEY=
# Results per search (1-80)
PEXELS_PER_PAGE=5
PEXELS_TIMEOUT=20
# Size cap for a downloaded photo, in bytes
PEXELS_MAX_BYTES=8000000

# --- Meta channels (Messenger / Instagram / WhatsApp) ------------------
GRAPH_API_VERSION=v21.0

# Optional globals. Leave blank to configure these per channel in the admin
# panel (recommended when each client uses a different Meta app).
# META_APP_SECRET is required to verify incoming webhook signatures.
META_APP_SECRET=
META_VERIFY_TOKEN=
