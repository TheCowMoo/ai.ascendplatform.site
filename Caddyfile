# Caddyfile for CMBGrowthAI
#
# Caddy obtains and renews TLS certificates automatically — there is no certbot,
# no nginx and no control panel to install. Point the domain's A/AAAA record at
# this server (ports 80 + 443 open) and HTTPS is provisioned on first request.
#
# ADMIN_DOMAIN comes from .env (defaults to localhost for local testing, which
# uses Caddy's internal CA).

{
	# The admin API lets the app reload Caddy after writing a site config.
	# Reachable only on the compose network; never published to the host.
	admin 0.0.0.0:2019

	# Where Let's Encrypt sends expiry warnings. Without this, certificates still issue -
	# but nobody hears about one that starts failing.
	email {$ACME_EMAIL:ops@example.com}

	# To exercise issuance end to end without burning the production rate limit, set
	# ACME_CA to the staging directory and confirm the whole loop once:
	#   acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	# Five failed validations in an hour locks a domain out of production.
}

{$ADMIN_DOMAIN:localhost} {
	encode zstd gzip
	log {
		output file /data/logs/admin.log
	}

	# The app (FastAPI + Flask over ASGI) on the compose network. Caddy sets
	# X-Forwarded-Proto itself, so there is nothing to add here.
	reverse_proxy app:8000 {
		header_up X-Real-IP {remote_host}
	}
}

# ---------------------------------------------------------------------------
# Hosted customer sites (Sites tab).
#
# The provisioner writes one file per domain into /etc/caddy/sites and reloads
# Caddy through its admin API. Each block gets its own certificate automatically
# as soon as the domain's DNS points here - no certbot, no per-site config in
# this file.
#
# Example of what gets generated:
#   example.com, www.example.com {
#     encode zstd gzip
#     root * /srv/sites/example.com/public_html
#     file_server
#   }
# ---------------------------------------------------------------------------
import /etc/caddy/sites/*.caddy
