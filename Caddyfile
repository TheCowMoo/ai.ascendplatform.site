# Caddyfile for CMBGrowthAI
#
# Caddy obtains and renews TLS certificates automatically - there is no certbot,
# no nginx and no control panel to install. Point the domain's A/AAAA record at
# this server (ports 80 + 443 open) and HTTPS is provisioned on first request.
#
# ADMIN_DOMAIN comes from .env (defaults to localhost for local testing, which
# uses Caddy's internal CA).
#
# Tabs, not spaces, and LF line endings: `caddy fmt` reports either as "input is
# not formatted" and quotes a line number, which reads like a layout problem. It
# is not one, and hunting for it wastes an afternoon.
#
# This file is mounted as a single file at /etc/caddy/Caddyfile. That means a
# deploy which changes it must recreate the container (a single-file bind mount
# stays pinned to the inode git replaces) - deploy.sh does that and then proves
# the site answers, rolling back if it does not.

{
	admin 0.0.0.0:2019
	email {$ACME_EMAIL:ops@example.com}
}

# The app (FastAPI + Flask over ASGI) on the compose network. Caddy sets
# X-Forwarded-Proto itself, so only the real client IP is added here.
{$ADMIN_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy app:8000 {
		header_up X-Real-IP {remote_host}
	}
}

# Hosted customer sites. The provisioner writes one file per domain into
# /etc/caddy/sites and reloads Caddy through its admin API; each block gets its
# own certificate as soon as the domain resolves here.
import /etc/caddy/sites/*.caddy
