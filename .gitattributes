# Keep the files Linux tools consume on LF, even though this repo is edited on
# Windows.
#
# This is not cosmetic: a CRLF deploy/install.sh dies under bash on the first
# line ("set: pipefail\r: invalid option name") and ends up with a stray CR in
# APP_DIR; a CRLF .dockerignore can stop patterns matching, which would bake .env
# (with every secret) into the image layer.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.ini           text eol=lf
*.conf          text eol=lf
Caddyfile       text eol=lf
.dockerignore   text eol=lf
.env.example    text eol=lf
requirements.txt text eol=lf
